RewriteEngine On

RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.dania360\.com$ [NC]
RewriteRule ^ https://dania360.com%{REQUEST_URI} [R=301,L]

# URL duplicadas: /index.html y /carpeta/index.html van a la URL con barra final.
RewriteCond %{THE_REQUEST} \s/+(?:[^?\s]*/)?index\.html[?\s] [NC]
RewriteRule ^(.*/)?index\.html$ https://dania360.com/$1 [R=301,L,NC]

# Archivos de trabajo del repositorio: no se publican.
RewriteRule ^(?:landing-src|sector-pages-src|restaurantes-src|docs)(?:/|$) - [F,L,NC]
RewriteRule (?:^|/)README\.md$ - [F,L,NC]

# Short affiliate link: preserve the complete, fixed Dania referral destination.
RewriteRule ^ver/?$ https://go.dania.ai/es/?via=jose-antonio-bustos-garcia-dania [R=302,L,NE]

<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|png|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
